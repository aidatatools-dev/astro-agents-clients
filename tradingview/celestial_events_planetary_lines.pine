//@version=5
// Celestial Events & Planetary Lines
// MIT License
//
// Gann planetary lines (geocentric and heliocentric), sign ingresses, stations (retrograde / direct)
// and eclipses, drawn on any chart. For your own analysis: not a trading signal, not a forecast.
//
// Two kinds of numbers, stated plainly:
//   * Events (ingresses, stations, eclipses) are EXACT: a table of 3,666 events 1990-2040,
//     each to the minute (UTC), computed in advance from the NASA/JPL DE440 ephemeris.
//   * Planetary lines are APPROXIMATE: Pine Script cannot load an ephemeris, so longitudes come from JPL's
//     Keplerian elements (Standish, Table 1, 1800-2050) with precession, nutation and light-time.
//     Measured against DE440 1990-2040: max error Sun <1', Mercury 1', Venus 2', Mars 4', Jupiter 5', Saturn 11', Uranus 2', Neptune 1', Pluto 1', Earth <1' (arcminutes, geocentric or heliocentric).
//
// Generated file: the event table is built by a script, edit the template, not this file.

indicator("Celestial Events & Planetary Lines", shorttitle = "Celestial", overlay = true,
     max_labels_count = 500, max_polylines_count = 100)

// ---------------------------------------------------------------- inputs
G_LINES = "Planetary lines (price = (degree + step x k) x price per degree)"
showGeo   = input.bool(true, "Geocentric lines", group = G_LINES, inline = "persp")
showHelio = input.bool(false, "Heliocentric lines", group = G_LINES, inline = "persp")
unitIn    = input.float(0.0, "Price per degree (0 = auto)", minval = 0.0, group = G_LINES,
     tooltip = "1 degree of longitude = this many price units. 0 picks a power of ten from the current price (10^(digits - 3)), which changes when price crosses a power of ten. Gann practice: 1, 10, 100... chosen by the user.")
stepDeg   = input.int(360, "A line every (degrees)", options = [360, 180, 120, 90, 60, 45, 30], group = G_LINES,
     tooltip = "360 = one line per full turn. 180 adds the opposition, 90 the squares, 120 the trines...")
projectDays = input.int(60, "Project lines forward (days, 0 = off)", minval = 0, maxval = 365, group = G_LINES)
lineWidth = input.int(1, "Line width", minval = 1, maxval = 4, group = G_LINES)

G_BODIES = "Bodies (lines and events)"
bSun = input.bool(true,  "Sun (geo) / Earth (helio)", group = G_BODIES, inline = "b1")
bMer = input.bool(false, "Mercury", group = G_BODIES, inline = "b1")
bVen = input.bool(false, "Venus",   group = G_BODIES, inline = "b2")
bMar = input.bool(true,  "Mars",    group = G_BODIES, inline = "b2")
bJup = input.bool(true,  "Jupiter", group = G_BODIES, inline = "b3")
bSat = input.bool(true,  "Saturn",  group = G_BODIES, inline = "b3")
bUra = input.bool(false, "Uranus",  group = G_BODIES, inline = "b4")
bNep = input.bool(false, "Neptune", group = G_BODIES, inline = "b4")
bPlu = input.bool(false, "Pluto",   group = G_BODIES, inline = "b5")
bM5  = input.bool(false, "Mean of 5 (Jupiter..Pluto)", group = G_BODIES, inline = "b6")
bC8  = input.bool(false, "Circle of 8 (Mercury..Pluto)", group = G_BODIES, inline = "b6")

G_EVENTS = "Events (exact, DE440)"
evIngress = input.bool(true, "Sign ingresses", group = G_EVENTS, inline = "e1")
evStation = input.bool(true, "Stations", group = G_EVENTS, inline = "e1")
evEclipse = input.bool(true, "Eclipses", group = G_EVENTS, inline = "e1")
evAll     = input.bool(false, "Events for every body (not only the selected ones)", group = G_EVENTS)
evFuture  = input.bool(true, "Show upcoming events (within the projection window)", group = G_EVENTS)

G_SHOW = "Display"
showTable = input.bool(true, "Positions table", group = G_SHOW)
tablePos  = input.string("bottom right", "Table position", options = ["top right", "bottom right", "bottom left", "top left"], group = G_SHOW)

// ---------------------------------------------------------------- ephemeris (approximate)
D2R = math.pi / 180.0
// a (au), e, I, L, long. perihelion, long. node, then their rates per Julian century; J2000 ecliptic.
// Order: 0 Mercury, 1 Venus, 2 Earth-Moon barycentre, 3 Mars, 4 Jupiter, 5 Saturn, 6 Uranus, 7 Neptune, 8 Pluto.
var float[] ELEM = array.from(
     0.38709927, 0.20563593, 7.00497902, 252.25032350, 77.45779628, 48.33076593, 0.00000037, 0.00001906, -0.00594749, 149472.67411175, 0.16047689, -0.12534081,
     0.72333566, 0.00677672, 3.39467605, 181.97909950, 131.60246718, 76.67984255, 0.00000390, -0.00004107, -0.00078890, 58517.81538729, 0.00268329, -0.27769418,
     1.00000261, 0.01671123, -0.00001531, 100.46457166, 102.93768193, 0.00000000, 0.00000562, -0.00004392, -0.01294668, 35999.37244981, 0.32327364, 0.00000000,
     1.52371034, 0.09339410, 1.84969142, -4.55343205, -23.94362959, 49.55953891, 0.00001847, 0.00007882, -0.00813131, 19140.30268499, 0.44441088, -0.29257343,
     5.20288700, 0.04838624, 1.30439695, 34.39644051, 14.72847983, 100.47390909, -0.00011607, -0.00013253, -0.00183714, 3034.74612775, 0.21252668, 0.20469106,
     9.53667594, 0.05386179, 2.48599187, 49.95424423, 92.59887831, 113.66242448, -0.00125060, -0.00050991, 0.00193609, 1222.49362201, -0.41897216, -0.28867794,
     19.18916464, 0.04725744, 0.77263783, 313.23810451, 170.95427630, 74.01692503, -0.00196176, -0.00004397, -0.00242939, 428.48202785, 0.40805281, 0.04240589,
     30.06992276, 0.00859048, 1.77004347, -55.12002969, 44.96476227, 131.78422574, 0.00026291, 0.00005105, 0.00035372, 218.45945325, -0.32241464, -0.00508664,
     39.48211675, 0.24882730, 17.14001206, 238.92903833, 224.06891629, 110.30393684, -0.00031596, 0.00005170, 0.00004818, 145.20780515, -0.04062942, -0.01183482)

el(int b, int i) =>
    array.get(ELEM, b * 12 + i)

mod360(float x) =>
    x - 360.0 * math.floor(x / 360.0)

wrap180(float x) =>
    mod360(x + 180.0) - 180.0

atan2deg(float y, float x) =>
    float r = 0.0
    if x > 0
        r := math.atan(y / x)
    else if x < 0
        r := math.atan(y / x) + (y >= 0 ? math.pi : -math.pi)
    else
        r := y > 0 ? math.pi / 2 : y < 0 ? -math.pi / 2 : 0.0
    r / D2R

centuries(int t) =>
    (t / 86400000.0 + 2440587.5 - 2451545.0) / 36525.0

// Short-period Saturn terms on Jupiter (degrees); the great inequality is already in the elements.
jupiterPert(float T) =>
    float mj = (el(4, 3) - el(4, 4) + (el(4, 9) - el(4, 10)) * T) * D2R
    float ms = (el(5, 3) - el(5, 4) + (el(5, 9) - el(5, 10)) * T) * D2R
    -0.056 * math.sin(2 * mj - 2 * ms + 21 * D2R) + 0.042 * math.sin(3 * mj - 5 * ms + 21 * D2R) - 0.036 * math.sin(mj - 2 * ms) + 0.022 * math.cos(mj - ms) + 0.023 * math.sin(2 * mj - 3 * ms + 52 * D2R) - 0.016 * math.sin(mj - 5 * ms - 69 * D2R)

// Heliocentric ecliptic J2000 coordinates (au).
helioXYZ(int b, float T) =>
    float a    = el(b, 0) + el(b, 6) * T
    float e    = el(b, 1) + el(b, 7) * T
    float inc  = (el(b, 2) + el(b, 8) * T) * D2R
    float lng  = el(b, 3) + el(b, 9) * T
    float wbar = el(b, 4) + el(b, 10) * T
    float node = el(b, 5) + el(b, 11) * T
    float w = (wbar - node) * D2R
    float M = mod360(lng - wbar)
    if M > 180.0
        M -= 360.0
    float Mr = M * D2R
    float E = Mr + e * math.sin(Mr)
    for k = 0 to 5
        E -= (E - e * math.sin(E) - Mr) / (1.0 - e * math.cos(E))
    float xp = a * (math.cos(E) - e)
    float yp = a * math.sqrt(1.0 - e * e) * math.sin(E)
    if b == 4
        float dj = jupiterPert(T) * D2R
        float xr = xp * math.cos(dj) - yp * math.sin(dj)
        yp := xp * math.sin(dj) + yp * math.cos(dj)
        xp := xr
    float cw = math.cos(w), sw = math.sin(w)
    float cn = math.cos(node * D2R), sn = math.sin(node * D2R)
    float ci = math.cos(inc), si = math.sin(inc)
    float x = (cw * cn - sw * sn * ci) * xp + (-sw * cn - cw * sn * ci) * yp
    float y = (cw * sn + sw * cn * ci) * xp + (-sw * sn + cw * cn * ci) * yp
    float z = sw * si * xp + cw * si * yp
    [x, y, z]

// J2000 ecliptic longitude -> true ecliptic and equinox of date.
ofDate(float lonJ2000, float T) =>
    float prec = (5028.796195 * T + 1.1054348 * T * T) / 3600.0
    float om = (125.04452 - 1934.136261 * T) * D2R
    float ls = (280.4665 + 36000.7698 * T) * D2R
    float lm = (218.3165 + 481267.8813 * T) * D2R
    float nut = (-17.20 * math.sin(om) - 1.32 * math.sin(2 * ls) - 0.23 * math.sin(2 * lm) + 0.21 * math.sin(2 * om)) / 3600.0
    mod360(lonJ2000 + prec + nut)

helioLon(int b, float T) =>
    [x, y, z] = helioXYZ(b, T)
    ofDate(atan2deg(y, x), T)

// Geocentric apparent longitude; b = 2 is the Sun (seen from the Earth).
geoLon(int b, float T) =>
    [ex, ey, ez] = helioXYZ(2, T)
    float lon = 0.0
    if b == 2
        lon := atan2deg(-ey, -ex) - 20.4898 / 3600.0
    else
        [x0, y0, z0] = helioXYZ(b, T)
        float dist = math.sqrt((x0 - ex) * (x0 - ex) + (y0 - ey) * (y0 - ey) + (z0 - ez) * (z0 - ez))
        [x1, y1, z1] = helioXYZ(b, T - dist * 0.0057755183 / 36525.0)
        lon := atan2deg(y1 - ey, x1 - ex)
    ofDate(lon, T)

// A line's base degree: id 0-8 a body (2 = Sun geo / Earth helio), 9 Mean of 5, 10 Circle of 8 (arithmetic means).
baseDeg(int persp, int id, float T) =>
    float d = na
    if id <= 8
        d := persp == 0 ? geoLon(id, T) : helioLon(id, T)
    else
        float s = 0.0
        int n = 0
        for b = (id == 9 ? 4 : 0) to 8
            if b != 2
                s += persp == 0 ? geoLon(b, T) : helioLon(b, T)
                n += 1
        d := s / n
    d

// ---------------------------------------------------------------- planetary lines
float Tbar = centuries(time)
float unit = unitIn > 0 ? unitIn : math.pow(10, math.floor(math.log10(close)) - 3)

isOn(int id) =>
    switch id
        0 => bMer
        1 => bVen
        2 => bSun
        3 => bMar
        4 => bJup
        5 => bSat
        6 => bUra
        7 => bNep
        8 => bPlu
        9 => bM5
        => bC8

// The two lines nearest to price: the harmonic just below the close and the one just above.
// A one-bar gap marks the moment price crosses a line (the nearest pair changes).
nearLine(bool on, float deg, float u, int above) =>
    float v = on ? u * (deg + stepDeg * (math.floor((close / u - deg) / stepDeg) + above)) : na
    float vp = v[1]
    na(vp) or math.abs(v - vp) < stepDeg * u * 0.5 ? v : na

C_MER = color.new(#8c8c8c, 0), C_VEN = color.new(#2e9e5b, 0), C_SUN = color.new(#e8a400, 0), C_MAR = color.new(#d63c2f, 0)
C_JUP = color.new(#3d6fd9, 0), C_SAT = color.new(#7a5230, 0), C_URA = color.new(#17a2b8, 0), C_NEP = color.new(#6f42c1, 0)
C_PLU = color.new(#333333, 0), C_M5 = color.new(#d6336c, 0), C_C8 = color.new(#fd7e14, 0)

bodyColor(int id) =>
    switch id
        0 => C_MER
        1 => C_VEN
        2 => C_SUN
        3 => C_MAR
        4 => C_JUP
        5 => C_SAT
        6 => C_URA
        7 => C_NEP
        8 => C_PLU
        9 => C_M5
        => C_C8

bool g0 = showGeo and bMer, bool g1 = showGeo and bVen, bool g2 = showGeo and bSun, bool g3 = showGeo and bMar
bool g4 = showGeo and bJup, bool g5 = showGeo and bSat, bool g6 = showGeo and bUra, bool g7 = showGeo and bNep
bool g8 = showGeo and bPlu, bool g9 = showGeo and bM5, bool g10 = showGeo and bC8
bool h0 = showHelio and bMer, bool h1 = showHelio and bVen, bool h2 = showHelio and bSun, bool h3 = showHelio and bMar
bool h4 = showHelio and bJup, bool h5 = showHelio and bSat, bool h6 = showHelio and bUra, bool h7 = showHelio and bNep
bool h8 = showHelio and bPlu, bool h9 = showHelio and bM5, bool h10 = showHelio and bC8

float gd0 = g0 ? baseDeg(0, 0, Tbar) : na, float gd1 = g1 ? baseDeg(0, 1, Tbar) : na, float gd2 = g2 ? baseDeg(0, 2, Tbar) : na
float gd3 = g3 ? baseDeg(0, 3, Tbar) : na, float gd4 = g4 ? baseDeg(0, 4, Tbar) : na, float gd5 = g5 ? baseDeg(0, 5, Tbar) : na
float gd6 = g6 ? baseDeg(0, 6, Tbar) : na, float gd7 = g7 ? baseDeg(0, 7, Tbar) : na, float gd8 = g8 ? baseDeg(0, 8, Tbar) : na
float gd9 = g9 ? baseDeg(0, 9, Tbar) : na, float gd10 = g10 ? baseDeg(0, 10, Tbar) : na
float hd0 = h0 ? baseDeg(1, 0, Tbar) : na, float hd1 = h1 ? baseDeg(1, 1, Tbar) : na, float hd2 = h2 ? baseDeg(1, 2, Tbar) : na
float hd3 = h3 ? baseDeg(1, 3, Tbar) : na, float hd4 = h4 ? baseDeg(1, 4, Tbar) : na, float hd5 = h5 ? baseDeg(1, 5, Tbar) : na
float hd6 = h6 ? baseDeg(1, 6, Tbar) : na, float hd7 = h7 ? baseDeg(1, 7, Tbar) : na, float hd8 = h8 ? baseDeg(1, 8, Tbar) : na
float hd9 = h9 ? baseDeg(1, 9, Tbar) : na, float hd10 = h10 ? baseDeg(1, 10, Tbar) : na

GEO = plot.style_linebr
plot(nearLine(g0, gd0, unit, 0), "Geo Mercury below", C_MER, lineWidth, GEO)
plot(nearLine(g0, gd0, unit, 1), "Geo Mercury above", C_MER, lineWidth, GEO)
plot(nearLine(g1, gd1, unit, 0), "Geo Venus below", C_VEN, lineWidth, GEO)
plot(nearLine(g1, gd1, unit, 1), "Geo Venus above", C_VEN, lineWidth, GEO)
plot(nearLine(g2, gd2, unit, 0), "Geo Sun below", C_SUN, lineWidth, GEO)
plot(nearLine(g2, gd2, unit, 1), "Geo Sun above", C_SUN, lineWidth, GEO)
plot(nearLine(g3, gd3, unit, 0), "Geo Mars below", C_MAR, lineWidth, GEO)
plot(nearLine(g3, gd3, unit, 1), "Geo Mars above", C_MAR, lineWidth, GEO)
plot(nearLine(g4, gd4, unit, 0), "Geo Jupiter below", C_JUP, lineWidth, GEO)
plot(nearLine(g4, gd4, unit, 1), "Geo Jupiter above", C_JUP, lineWidth, GEO)
plot(nearLine(g5, gd5, unit, 0), "Geo Saturn below", C_SAT, lineWidth, GEO)
plot(nearLine(g5, gd5, unit, 1), "Geo Saturn above", C_SAT, lineWidth, GEO)
plot(nearLine(g6, gd6, unit, 0), "Geo Uranus below", C_URA, lineWidth, GEO)
plot(nearLine(g6, gd6, unit, 1), "Geo Uranus above", C_URA, lineWidth, GEO)
plot(nearLine(g7, gd7, unit, 0), "Geo Neptune below", C_NEP, lineWidth, GEO)
plot(nearLine(g7, gd7, unit, 1), "Geo Neptune above", C_NEP, lineWidth, GEO)
plot(nearLine(g8, gd8, unit, 0), "Geo Pluto below", C_PLU, lineWidth, GEO)
plot(nearLine(g8, gd8, unit, 1), "Geo Pluto above", C_PLU, lineWidth, GEO)
plot(nearLine(g9, gd9, unit, 0), "Geo Mean of 5 below", C_M5, lineWidth, GEO)
plot(nearLine(g9, gd9, unit, 1), "Geo Mean of 5 above", C_M5, lineWidth, GEO)
plot(nearLine(g10, gd10, unit, 0), "Geo Circle of 8 below", C_C8, lineWidth, GEO)
plot(nearLine(g10, gd10, unit, 1), "Geo Circle of 8 above", C_C8, lineWidth, GEO)
HEL = plot.style_circles
plot(nearLine(h0, hd0, unit, 0), "Helio Mercury below", C_MER, lineWidth, HEL)
plot(nearLine(h0, hd0, unit, 1), "Helio Mercury above", C_MER, lineWidth, HEL)
plot(nearLine(h1, hd1, unit, 0), "Helio Venus below", C_VEN, lineWidth, HEL)
plot(nearLine(h1, hd1, unit, 1), "Helio Venus above", C_VEN, lineWidth, HEL)
plot(nearLine(h2, hd2, unit, 0), "Helio Earth below", C_SUN, lineWidth, HEL)
plot(nearLine(h2, hd2, unit, 1), "Helio Earth above", C_SUN, lineWidth, HEL)
plot(nearLine(h3, hd3, unit, 0), "Helio Mars below", C_MAR, lineWidth, HEL)
plot(nearLine(h3, hd3, unit, 1), "Helio Mars above", C_MAR, lineWidth, HEL)
plot(nearLine(h4, hd4, unit, 0), "Helio Jupiter below", C_JUP, lineWidth, HEL)
plot(nearLine(h4, hd4, unit, 1), "Helio Jupiter above", C_JUP, lineWidth, HEL)
plot(nearLine(h5, hd5, unit, 0), "Helio Saturn below", C_SAT, lineWidth, HEL)
plot(nearLine(h5, hd5, unit, 1), "Helio Saturn above", C_SAT, lineWidth, HEL)
plot(nearLine(h6, hd6, unit, 0), "Helio Uranus below", C_URA, lineWidth, HEL)
plot(nearLine(h6, hd6, unit, 1), "Helio Uranus above", C_URA, lineWidth, HEL)
plot(nearLine(h7, hd7, unit, 0), "Helio Neptune below", C_NEP, lineWidth, HEL)
plot(nearLine(h7, hd7, unit, 1), "Helio Neptune above", C_NEP, lineWidth, HEL)
plot(nearLine(h8, hd8, unit, 0), "Helio Pluto below", C_PLU, lineWidth, HEL)
plot(nearLine(h8, hd8, unit, 1), "Helio Pluto above", C_PLU, lineWidth, HEL)
plot(nearLine(h9, hd9, unit, 0), "Helio Mean of 5 below", C_M5, lineWidth, HEL)
plot(nearLine(h9, hd9, unit, 1), "Helio Mean of 5 above", C_M5, lineWidth, HEL)
plot(nearLine(h10, hd10, unit, 0), "Helio Circle of 8 below", C_C8, lineWidth, HEL)
plot(nearLine(h10, hd10, unit, 1), "Helio Circle of 8 above", C_C8, lineWidth, HEL)

// Forward projection (dotted): the same two harmonics, continued from the last bar. TradingView draws
// at most 500 bars ahead, so the window is also capped at 490 bars of the chart's timeframe.
int horizonMs = int(math.min(projectDays * 86400000.0, 490.0 * nz(timeframe.in_seconds(), 86400) * 1000.0))
var polyline[] projections = array.new<polyline>()
if barstate.islast
    while array.size(projections) > 0
        polyline.delete(array.pop(projections))
    if projectDays > 0
        int steps = 120
        for persp = 0 to 1
            for id = 0 to 10
                if (persp == 0 ? showGeo : showHelio) and isOn(id)
                    float d0 = baseDeg(persp, id, Tbar)
                    float k = math.floor((close / unit - d0) / stepDeg)
                    chart.point[] lo = array.new<chart.point>()
                    chart.point[] hi = array.new<chart.point>()
                    float cum = d0
                    float prev = d0
                    for i = 0 to steps
                        int t = time + int(i * horizonMs / steps)
                        float d = baseDeg(persp, id, centuries(t))
                        cum += wrap180(d - prev)
                        prev := d
                        array.push(lo, chart.point.from_time(t, unit * (cum + stepDeg * k)))
                        array.push(hi, chart.point.from_time(t, unit * (cum + stepDeg * (k + 1))))
                    color c = bodyColor(id)
                    array.push(projections, polyline.new(lo, xloc = xloc.bar_time, line_color = c, line_style = persp == 0 ? line.style_dotted : line.style_dashed, line_width = lineWidth))
                    array.push(projections, polyline.new(hi, xloc = xloc.bar_time, line_color = c, line_style = persp == 0 ? line.style_dotted : line.style_dashed, line_width = lineWidth))

// ---------------------------------------------------------------- events (exact, DE440)
// One integer per event: minute_utc * 10000 + body * 1000 + type * 100 + detail
//   body: 0 none (eclipse), 1 Sun, 2 Mercury, 3 Venus, 4 Mars, 5 Jupiter, 6 Saturn, 7 Uranus, 8 Neptune, 9 Pluto
//   type: 1 ingress (detail = sign 0-11, +20 when retrograde), 2 station (detail 0 = turns retrograde, 1 = turns direct),
//         3 eclipse (detail 11 solar total, 12 annular, 13 hybrid, 14 partial; 21 lunar total, 24 partial, 25 penumbral)
var int[] EV = array.new_int(0)
if barstate.isfirst
    array.concat(EV, array.from(
      105417233129, 105468322201, 105470421110, 105563700312, 105603704109, 105744803201, 105765110321, 105797512110, 105896541111, 105897649200, 105980825201, 106080742111,
      106081123110, 106195144110, 106315242100, 106327991100, 106535752101, 106565533111, 106671817200, 106707758200, 106766671101, 106774894111, 106808952200, 106965523100,
      106975956200, 107151632201, 107212571102, 107343733101, 107356314100, 107525092102, 107663731103, 107712143102, 107753262103, 107956682104, 107965644101, 108074213103,
      108102620311, 108116621104, 108157139201, 108208302105, 108325320324, 108430853104, 108494105104, 108567211105, 108598882200, 108683794102, 108782613105, 108888667201,
      108928862201, 109010566201, 109012151106, 109017608201, 109130533106, 109191442106, 109408394200, 109441062107, 109449741107, 109476033107, 109713662108, 109820383108,
      109880271108, 109989615200, 110016132109, 110164383109, 110193464121, 110201482200, 110305871109, 110360972128, 110455714201, 110487522201, 110508633110, 110640022109,
      110663930312, 110729871110, 110736754102, 110854043111, 110869190325, 110965402110, 110977716110, 111155981111, 111193739200, 111202223100, 111227152111, 111455202100,
