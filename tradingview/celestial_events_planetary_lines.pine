BODY_NAMES = array.from("", "Sun", "Mercury", "Venus", "Mars", "Jupiter", "Saturn", "Uranus", "Neptune", "Pluto")
BODY_GLYPHS = array.from("", "☉", "☿", "♀", "♂", "♃", "♄", "♅", "♆", "♇")
SIGN_NAMES = array.from("Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius", "Capricorn", "Aquarius", "Pisces")
SIGN_GLYPHS = array.from("♈", "♉", "♊", "♋", "♌", "♍", "♎", "♏", "♐", "♑", "♒", "♓")

evTime(int v) =>
    int(math.floor(v / 10000)) * 60000

// Line id (0-8) of an event body (1-9): the body toggles above also filter the events.
evSelected(int body) =>
    evAll or body == 0 or isOn(body == 1 ? 2 : body == 2 ? 0 : body == 3 ? 1 : body - 1)

evShown(int v) =>
    int typ = int(math.floor(v / 100)) % 10
    int body = int(math.floor(v / 1000)) % 10
    (typ == 1 and evIngress or typ == 2 and evStation or typ == 3 and evEclipse) and evSelected(body)

evShort(int v) =>
    int typ = int(math.floor(v / 100)) % 10
    int body = int(math.floor(v / 1000)) % 10
    int det = v % 100
    string s = ""
    if typ == 1
        s := array.get(BODY_GLYPHS, body) + "→" + array.get(SIGN_GLYPHS, det % 20) + (det >= 20 ? "℞" : "")
    else if typ == 2
        s := array.get(BODY_GLYPHS, body) + (det == 0 ? " ℞" : " D")
    else
        s := det < 20 ? "☉ eclipse" : "☽ eclipse"
    s

pad2(int n) =>
    (n < 10 ? "0" : "") + str.tostring(n)

utcStamp(int t) =>
    str.tostring(year(t, "UTC")) + "-" + pad2(month(t, "UTC")) + "-" + pad2(dayofmonth(t, "UTC")) + " " + pad2(hour(t, "UTC")) + ":" + pad2(minute(t, "UTC"))

evLong(int v) =>
    int typ = int(math.floor(v / 100)) % 10
    int body = int(math.floor(v / 1000)) % 10
    int det = v % 100
    string s = ""
    if typ == 1
        s := array.get(BODY_NAMES, body) + " enters " + array.get(SIGN_NAMES, det % 20) + (det >= 20 ? " (retrograde)" : "")
    else if typ == 2
        s := array.get(BODY_NAMES, body) + (det == 0 ? " stations retrograde" : " stations direct")
    else
        string kind = det % 10 == 1 ? "total" : det % 10 == 2 ? "annular" : det % 10 == 3 ? "hybrid" : det % 10 == 4 ? "partial" : "penumbral"
        s := (det < 20 ? "Solar" : "Lunar") + " eclipse (" + kind + ")"
    s + "\n" + str.format_time(evTime(v), "yyyy-MM-dd HH:mm", "UTC") + " UTC, exact (DE440)"

var int evIdx = 0
int barEnd = na(time_close) ? time + (time - nz(time[1], time - 86400000)) : time_close
if barstate.isfirst
    while evIdx < array.size(EV) ? evTime(array.get(EV, evIdx)) < time : false
        evIdx += 1

string shortTxt = ""
string longTxt = ""
bool hasIngress = false, bool hasStation = false, bool hasEclipse = false
while evIdx < array.size(EV) ? evTime(array.get(EV, evIdx)) < barEnd : false
    int v = array.get(EV, evIdx)
    if evShown(v)
        shortTxt += (shortTxt == "" ? "" : "\n") + evShort(v)
        longTxt += (longTxt == "" ? "" : "\n\n") + evLong(v)
        int typ = int(math.floor(v / 100)) % 10
        hasIngress := hasIngress or typ == 1
        hasStation := hasStation or typ == 2
        hasEclipse := hasEclipse or typ == 3
    evIdx += 1

if shortTxt != ""
    label.new(bar_index, high, shortTxt, yloc = yloc.abovebar, style = label.style_label_down, size = size.small,
         color = hasEclipse ? color.new(#111111, 10) : hasStation ? color.new(#6f42c1, 15) : color.new(#3d6fd9, 25),
         textcolor = color.white, tooltip = longTxt)
plotshape(hasEclipse, "Eclipse", shape.diamond, location.belowbar, color.new(#111111, 0), size = size.tiny)
plotshape(hasStation, "Station", shape.triangleup, location.belowbar, color.new(#6f42c1, 0), size = size.tiny)
plotshape(hasIngress, "Ingress", shape.circle, location.belowbar, color.new(#3d6fd9, 0), size = size.tiny)

// Upcoming events inside the projection window, at their exact time on the future axis.
var label[] upcoming = array.new<label>()
if barstate.islast
    while array.size(upcoming) > 0
        label.delete(array.pop(upcoming))
    if evFuture and projectDays > 0
        int horizon = time + horizonMs
        int j = evIdx
        while (j < array.size(EV) ? evTime(array.get(EV, j)) < horizon : false) and array.size(upcoming) < 60
            int v = array.get(EV, j)
            if evShown(v)
                array.push(upcoming, label.new(evTime(v), close, evShort(v), xloc = xloc.bar_time, yloc = yloc.price,
                     style = label.style_label_down, size = size.small, color = color.new(#888888, 30),
                     textcolor = color.white, tooltip = evLong(v)))
            j += 1

// ---------------------------------------------------------------- positions table
fmtPos(float deg) =>
    float d = mod360(deg)
    int s = int(math.floor(d / 30))
    float within = d - 30 * s
    int dd = int(math.floor(within))
    int mm = int(math.floor((within - dd) * 60))
    str.tostring(dd) + "°" + (mm < 10 ? "0" : "") + str.tostring(mm) + "' " + array.get(SIGN_GLYPHS, s)

var table posTable = na
if showTable and barstate.islast
    if not na(posTable)
        table.delete(posTable)
    string where = tablePos == "top right" ? position.top_right : tablePos == "bottom left" ? position.bottom_left : tablePos == "top left" ? position.top_left : position.bottom_right
    posTable := table.new(where, 3, 12, bgcolor = color.new(color.black, 80), border_width = 0)
    table.cell(posTable, 0, 0, "", text_color = color.gray, text_size = size.small)
    table.cell(posTable, 1, 0, "Geo", text_color = color.gray, text_size = size.small)
    table.cell(posTable, 2, 0, "Helio", text_color = color.gray, text_size = size.small)
    for id = 0 to 8
        // rows in the usual order: Sun first
        int b = id == 0 ? 2 : id <= 2 ? id - 1 : id
        float g = geoLon(b, Tbar)
        bool retro = b != 2 and wrap180(geoLon(b, Tbar + 1.0 / 36525.0) - g) < 0
        string name = b == 2 ? "☉ Sun / Earth" : array.get(BODY_GLYPHS, b < 2 ? b + 2 : b + 1) + " " + array.get(BODY_NAMES, b < 2 ? b + 2 : b + 1)
        table.cell(posTable, 0, id + 1, name, text_color = bodyColor(b), text_size = size.small, text_halign = text.align_left)
        table.cell(posTable, 1, id + 1, fmtPos(g) + (retro ? " ℞" : ""), text_color = color.white, text_size = size.small)
        table.cell(posTable, 2, id + 1, fmtPos(helioLon(b, Tbar)), text_color = color.silver, text_size = size.small)
    table.cell(posTable, 0, 10, "Positions: approximate (max error 11')", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(posTable, 0, 10, 2, 10)
    table.cell(posTable, 0, 11, "Events: exact to the minute (DE440)", text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
    table.merge_cells(posTable, 0, 11, 2, 11)
